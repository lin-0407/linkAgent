<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.11</version>
        <relativePath/>
    </parent>

    <groupId>com.link</groupId>
    <artifactId>linkAgent</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>linkAgent</name>
    <description>基于 Spring AI 的视频创作者智能工作台</description>

    <properties>
        <java.version>21</java.version>
        <spring-ai.version>1.1.4</spring-ai.version>
        <!-- AWS SDK Java 2.x 版本。
             2026-07-13 从 Maven Central 元数据核对并固定为 2.47.5。
             必须显式固定而非使用 RELEASE/LATEST，原因：
             1. Maven 的动态版本解析在不同时间可能拉到不同版本，导致构建不可复现
             2. AWS SDK 小版本升级可能改变 S3 客户端默认行为（如签名算法、重试策略）
             3. 固定版本后通过 Dependabot/Renovate 等工具主动升级，而非被动漂移 -->
        <aws-sdk.version>2.47.5</aws-sdk.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    </properties>

    <!-- Spring AI BOM，统一管理所有 spring-ai 子模块版本 -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- AWS SDK BOM：统一管理 S3 客户端及其所有传递依赖的版本。
                 使用 BOM 的原因：
                 1. S3 模块依赖 aws-core、auth、regions 等多个子模块，BOM 确保版本一致
                 2. 避免手动逐个声明传递依赖的版本，降低版本冲突风险
                 3. 未来增加其他 AWS 服务（如 SQS、SNS）时只需新增 artifactId，版本由 BOM 统一管理 -->
            <dependency>
                <groupId>software.amazon.awssdk</groupId>
                <artifactId>bom</artifactId>
                <version>${aws-sdk.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>

        <!-- ===== Web 层 ===== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- ===== Spring AI ===== -->
        <!-- OpenAI 兼容接口（Qwen / DeepSeek 均支持 OpenAI 协议） -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-openai</artifactId>
        </dependency>
        <!-- MCP 客户端，接入外部 MCP Server -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-mcp-client</artifactId>
        </dependency>
        <!-- Milvus 向量库 -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-vector-store-milvus</artifactId>
        </dependency>
        <!-- Modular RAG 查询变换组件（5.2b 查询增强：RewriteQueryTransformer / MultiQueryExpander），版本由 spring-ai-bom 统一管理 -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-rag</artifactId>
        </dependency>

        <!-- ===== 数据层 ===== -->
        <!-- Redis 短期记忆 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <!-- MyBatis + MySQL 长期记忆 -->
        <dependency>
            <groupId>org.mybatis.spring.boot</groupId>
            <artifactId>mybatis-spring-boot-starter</artifactId>
            <version>3.0.5</version>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- ===== 文档解析（Apache Tika 1.28.5，提取 PDF/DOCX/TXT/MD 文本）===== -->
        <dependency>
            <groupId>org.apache.tika</groupId>
            <artifactId>tika-core</artifactId>
            <version>1.28.5</version>
        </dependency>
        <dependency>
            <groupId>org.apache.tika</groupId>
            <artifactId>tika-parsers</artifactId>
            <version>1.28.5</version>
            <!-- 排除 Tika 自带的 commons-logging，避免与 Spring Boot 的 jcl-over-slf4j 冲突 -->
            <exclusions>
                <exclusion>
                    <groupId>commons-logging</groupId>
                    <artifactId>commons-logging</artifactId>
                </exclusion>
                <!-- 排除 Tika 传递的旧版 protobuf-java，避免与 Milvus SDK 所需版本冲突 -->
                <exclusion>
                    <groupId>com.google.protobuf</groupId>
                    <artifactId>protobuf-java</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- ===== 工具 ===== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- Actuator，暴露健康检查与指标端点 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- 阶段 7 P0：AWS S3 SDK（通过阿里云 OSS 的 S3 兼容接口使用）。
             用途：
             1. CreateMultipartUpload — 创建 OSS 分片上传
             2. S3Presigner — 为浏览器直传生成短时预签名 PUT URL
             3. CompleteMultipartUpload — 合并分片为完整对象
             4. AbortMultipartUpload — 取消上传释放分片
             5. HeadObject / DeleteObject — 对象校验与清理
             不使用阿里云官方 OSS SDK 的原因：S3 兼容接口可随时切换为 AWS S3/MinIO 等其它 S3 服务。
             版本由上方 BOM 统一管理，此处无需写 version。 -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>s3</artifactId>
        </dependency>

        <!-- ===== 测试 ===== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>


        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
            <!-- 显式指定编译器版本，确保使用 JDK 21 语言特性 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <release>21</release>
                    <encoding>UTF-8</encoding>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
