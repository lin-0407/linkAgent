LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
# DeepSeek strict Function Calling 走独立 Beta 路径，关闭后直接使用原有 json_object / 结构化 ReAct。
LLM_STRICT_FUNCTION_CALLING_ENABLED=true
LLM_STRICT_BASE_URL=https://api.deepseek.com
LLM_STRICT_COMPLETIONS_PATH=/beta/chat/completions
LLM_STRICT_MODEL=deepseek-chat
# DeepSeek Flash 默认开启深度思考并使用最高思考强度；设置页也可以在线调整。
DEEPSEEK_THINKING_ENABLED=true
DEEPSEEK_REASONING_EFFORT=max
# 用于加密用户保存的模型 API Key；生产环境执行 openssl rand -base64 32 生成。
LINKAGENT_AES_KEY=
WEB_SEARCH_ENABLED=false
WEB_SEARCH_BING_BASE_URL=https://cn.bing.com
WEB_SEARCH_DUCKDUCKGO_BASE_URL=https://html.duckduckgo.com
WEB_SEARCH_COMPRESSION_ENABLED=true
WEB_SEARCH_COMPRESSION_MODEL=deepseek-v4-flash
# 工具结果体积控制：单条超过 2000 字符先摘要再进上下文，原文仍完整落 t_agent_step。
TOOL_RESULT_COMPRESSION_ENABLED=true
TOOL_RESULT_COMPRESSION_MODEL=deepseek-v4-flash
# 成本保护上限，单位是 token（官方词表本地计量，不是字符数）。
LLM_GUARD_ENABLED=true
LLM_GUARD_MAX_PROMPT_TOKENS=768000
# 记忆压缩：请求上下文超过该 token 数时先摘要再裁剪短期记忆。
SUMMARY_MEMORY_ENABLED=true
SUMMARY_MEMORY_TRIGGER_TOKEN_THRESHOLD=256000
SUMMARY_MEMORY_RETAINED_MESSAGE_COUNT=2

DB_URL=jdbc:mysql://localhost:3306/link_agent?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai
DB_USERNAME=link_agent
DB_PASSWORD=

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

VECTOR_STORE_TYPE=milvus

# ========== 向量 Embedding（Docker 默认开启） ==========
# Docker Compose 默认启动 Milvus 并开启 Embedding，两个 RAG 功能也默认开启。
EMBEDDING_MODEL_TYPE=openai
# 留空时 Docker Compose 复用下方 DASHSCOPE_API_KEY；请填可调用 Qwen Embedding 的百炼 Key。
LLM_EMBEDDING_API_KEY=
LLM_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com
LLM_EMBEDDING_MODEL=text-embedding-v4
# Embedding 输出维度必须与反馈 RAG 的 Milvus 集合维度一致。
LLM_EMBEDDING_DIMENSIONS=1024

# 仅用于直接在宿主机运行后端；Docker Compose 内会固定使用服务名 milvus。
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_USERNAME=
MILVUS_PASSWORD=
MILVUS_DATABASE_NAME=default
MILVUS_COLLECTION_NAME=creator_feedback_evidence
# 默认自动创建反馈 RAG 集合；Embedding 输出与集合维度统一为 1024。
MILVUS_INITIALIZE_SCHEMA=true
MILVUS_EMBEDDING_DIMENSION=1024

# ========== 反馈追问 RAG 业务开关（阶段 4.13） ==========
# 独立于基础设施开关：即使 Milvus 已连上，也只有 CREATOR_FEEDBACK_RAG_ENABLED=true 才走向量检索。
CREATOR_FEEDBACK_RAG_ENABLED=true
CREATOR_FEEDBACK_RAG_TOP_K=8
CREATOR_FEEDBACK_RAG_MAX_INDEX_ITEMS=300

# ========== 视频案例知识库 RAG 业务开关（阶段 5.1） ==========
# 与反馈 RAG 使用独立集合；Docker 默认开启并使用上面的 Milvus 连接和 1024 维 Embedding。
KNOWLEDGE_RAG_ENABLED=true
KNOWLEDGE_RAG_COLLECTION_NAME=creator_reference_video
KNOWLEDGE_RAG_INDEX_BATCH_SIZE=10
KNOWLEDGE_RAG_INITIALIZE_SCHEMA=true

# ========== 阶段 7 P0 私有成片上传（Docker 默认开启） ==========
# 启动前先在阿里云 OSS 香港地域创建私有 Bucket，并配置允许前端 Origin 的 CORS：
# Methods=PUT,GET,HEAD；AllowedHeaders=*；ExposeHeaders=ETag；不要把 Bucket 改成公共读。
CREATOR_MEDIA_ENABLED=true
# Docker 镜像自带固定渲染器；这些开关启用已授权制作的后台推进，不会自行新建制作。
CREATOR_CREATION_WORKER_ENABLED=true
CREATOR_CREATION_RENDERER_ENABLED=true
CREATOR_CREATION_MEDIA_ENABLED=true
# 配音和 AI 视频仍需在设置页配置供应商，并在制作时明确确认费用。
CREATOR_CREATION_VOICE_ENABLED=false
CREATOR_CREATION_VIDEO_ENABLED=false
CREATOR_MEDIA_FFPROBE_PATH=ffprobe
CREATOR_MEDIA_FFMPEG_PATH=ffmpeg
CREATOR_MEDIA_PROBE_TIMEOUT=30s
CREATOR_MEDIA_FFMPEG_TIMEOUT=2h
CREATOR_MEDIA_PROVIDER_READ_TTL=5m
CREATOR_MEDIA_WORK_ROOT=/var/lib/linkagent-media-work
# 价格仅用于前端预估展示，不代表供应商最终账单；上线前按实际配置校准
CREATOR_MEDIA_PRICING_VERSION=2026-10-11-plus-config-v2
CREATOR_MEDIA_FLASH_INPUT_USD_PER_MILLION_TOKENS=0.022
CREATOR_MEDIA_FLASH_OUTPUT_USD_PER_MILLION_TOKENS=0.215
CREATOR_MEDIA_PLUS_INPUT_USD_PER_MILLION_TOKENS=0.144
CREATOR_MEDIA_PLUS_OUTPUT_USD_PER_MILLION_TOKENS=1.434
CREATOR_MEDIA_ASR_USD_PER_SECOND=0.000035
# P0-3 文件转写使用 DashScope 中国区端点；该 Key 与阿里云百炼 LLM API Key 属于同一账号体系。
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com
CREATOR_MEDIA_ASR_MODEL=qwen3-asr-flash-filetrans
CREATOR_MEDIA_VIDEO_MODEL=qwen3-vl-plus
CREATOR_MEDIA_VIDEO_FPS=0.2
CREATOR_MEDIA_PREFLIGHT_POLL_INTERVAL_MS=2000
CREATOR_MEDIA_PREFLIGHT_LEASE_DURATION=90s
CREATOR_MEDIA_PREFLIGHT_MAX_ATTEMPTS=3
CREATOR_MEDIA_PREFLIGHT_PROVIDER_POLL_INTERVAL=5s
CREATOR_MEDIA_ASR_CONNECT_TIMEOUT=10s
CREATOR_MEDIA_ASR_READ_TIMEOUT=30s
CREATOR_MEDIA_VIDEO_READ_TIMEOUT=10m
MEDIA_S3_INTERNAL_ENDPOINT=https://s3.oss-cn-hongkong.aliyuncs.com
MEDIA_S3_BROWSER_ENDPOINT=https://s3.oss-cn-hongkong.aliyuncs.com
MEDIA_S3_PROVIDER_ENDPOINT=https://s3.oss-cn-hongkong.aliyuncs.com
MEDIA_S3_REGION=aws-global
MEDIA_S3_ACCESS_KEY=
MEDIA_S3_SECRET_KEY=
MEDIA_S3_BUCKET=

# Docker Compose 演示环境变量。
# 这些值只用于本地演示，真正部署时要换成自己的强密码。
# 演示库名固定为 link_agent，避免和初始化脚本出现库名分叉。
# 构建后端镜像时的 apt 源，默认官方 archive.ubuntu.com。
# 注意：实测 http://mirrors.aliyun.com 的 universe 索引不可用（apt 报 Unable to locate package ffmpeg），
# 要换源请先确认该镜像站有 <codename>/universe（codename 见 Dockerfile 里固定的 -noble）。
# APT_UBUNTU_MIRROR=http://mirrors.tuna.tsinghua.edu.cn
MYSQL_ROOT_PASSWORD=link_agent_root_password
MYSQL_USER=link_agent
MYSQL_PASSWORD=link_agent_password
FRONTEND_PORT=8088
