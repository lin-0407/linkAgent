LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

DB_URL=jdbc:mysql://localhost:3306/link_agent?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
DB_USERNAME=link_agent
DB_PASSWORD=

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

VECTOR_STORE_TYPE=none

# ========== 向量 Embedding（阶段 4.13 反馈追问 RAG，默认关闭） ==========
# 三个变量全部保持默认值时，不启动 Milvus、不调用 Embedding、不影响演示路径。
# 开启步骤：1) 启动 Milvus Standalone；2) 填写下面变量；3) 重启后端。
EMBEDDING_MODEL_TYPE=none
# Embedding API 凭证，留空时复用 LLM_API_KEY / LLM_BASE_URL（同一个 OpenAI 兼容网关）。
LLM_EMBEDDING_API_KEY=
LLM_EMBEDDING_BASE_URL=
LLM_EMBEDDING_MODEL=text-embedding-3-small
# 向量维度，必须和 Milvus 集合维度 MILVUS_EMBEDDING_DIMENSION 保持一致，否则写入时报维度冲突。
LLM_EMBEDDING_DIMENSIONS=1536

MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_USERNAME=
MILVUS_PASSWORD=
MILVUS_DATABASE_NAME=default
MILVUS_COLLECTION_NAME=creator_feedback_evidence
# 首次建集合前设 true，建好后改回 false，避免每次启动都尝试初始化 schema。
MILVUS_INITIALIZE_SCHEMA=false
MILVUS_EMBEDDING_DIMENSION=1536

# ========== 反馈追问 RAG 业务开关（阶段 4.13） ==========
# 独立于基础设施开关：即使 Milvus 已连上，也只有 CREATOR_FEEDBACK_RAG_ENABLED=true 才走向量检索。
CREATOR_FEEDBACK_RAG_ENABLED=false
CREATOR_FEEDBACK_RAG_TOP_K=8
CREATOR_FEEDBACK_RAG_MAX_INDEX_ITEMS=300

# ========== 视频案例知识库 RAG 业务开关（阶段 5.1） ==========
# 独立于反馈 RAG：默认关闭时不连 Milvus、不调 Embedding，案例导入与列表照常工作。
# 开启步骤：1) 启动 Milvus；2) 把 Embedding 切到 Qwen text-embedding-v4 并设 LLM_EMBEDDING_DIMENSIONS=1024；
#          3) 设 KNOWLEDGE_RAG_ENABLED=true；4) 重启后端。Milvus 连接复用上面的 MILVUS_* 变量。
KNOWLEDGE_RAG_ENABLED=false
KNOWLEDGE_RAG_COLLECTION_NAME=creator_reference_video
KNOWLEDGE_RAG_INDEX_BATCH_SIZE=10
KNOWLEDGE_RAG_INITIALIZE_SCHEMA=true

# Docker Compose 演示环境变量。
# 这些值只用于本地演示，真正部署时要换成自己的强密码。
# 演示库名固定为 link_agent，避免和初始化脚本出现库名分叉。
MYSQL_ROOT_PASSWORD=link_agent_root_password
MYSQL_USER=link_agent
MYSQL_PASSWORD=link_agent_password
FRONTEND_PORT=8088
